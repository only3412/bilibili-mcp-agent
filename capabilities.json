{
  "version": "0.1.0",
  "transport": [
    "stdio",
    "streamable-http"
  ],
  "categories": [
    "专栏",
    "互动写入",
    "动态",
    "发现",
    "字幕与弹幕",
    "收藏",
    "用户",
    "直播",
    "视频",
    "评论",
