  "tools": [
    {
      "name": "bilibili_search",
      "category": "发现",
      "description": "分类搜索视频、UP主、直播间、专栏和影视。返回分页原始结构；标题可能含高亮HTML。",
      "method": "GET",
      "url": "https://api.bilibili.com/x/web-interface/search/type",
      "authentication": "public / session optional",
      "wbi": false,
      "schema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "search_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "video",
            "enum": [
              "video",
              "bili_user",
              "live_room",
              "live_user",
              "article",
              "media_bangumi",
              "media_ft"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1
          },
          "order": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "default": "totalrank",
            "enum": [
              "totalrank",
              "click",
              "pubdate",
              "dm",
              "stow",
              "scores",
              "fans",
              "level"
            ]
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "default": 0
          },
          "tids": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      }
    },
